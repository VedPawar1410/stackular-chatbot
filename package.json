{
  "scripts": {
    "dev:api": "cd stackular-api && python -m uvicorn main:app --reload --port 8000",
    "dev:web": "cd stackular-frontend && npm run dev",
    "dev:all": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\""
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
